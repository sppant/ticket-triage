# --- API ---------------------------------------------------------------
# Port the API listens on.
PORT=3001
# Origin allowed by CORS (the web UI).
CORS_ORIGIN=http://localhost:3000
# Set to "fake" to use the deterministic fake provider for every request
# (tests, CI, UI demos). Leave empty for normal routing.
TRIAGE_PROVIDER=

# --- Local model (Ollama) ---------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
# Any instruct model you have pulled, e.g. `ollama pull llama3.2:1b`.
OLLAMA_MODEL=llama3.2:1b

# --- Hosted model (Anthropic) -----------------------------------------
# Optional. When empty, every ticket is handled by the local model.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Observability ----------------------------------------------------
# Spans go to the console unless this is set (OTLP/HTTP, e.g. http://localhost:4318).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=ticket-triage
# pino log level: trace|debug|info|warn|error|fatal|silent
LOG_LEVEL=info

# --- Evaluation (npm run eval) ----------------------------------------
# Set to 1 to include the fake provider (a test double) in eval runs.
EVAL_INCLUDE_FAKE=
# Hosted-model prices in USD per million tokens, used for cost estimates.
EVAL_ANTHROPIC_INPUT_PER_MTOK=0.10
EVAL_ANTHROPIC_OUTPUT_PER_MTOK=0.50

# --- MCP server -------------------------------------------------------
# Dataset the MCP server searches (default: eval/dataset.jsonl).
MCP_DATASET_PATH=

# --- Web UI (web/.env.local) -----------------------------------------
# Base URL of the API, read by the browser.
NEXT_PUBLIC_API_URL=http://localhost:3001
